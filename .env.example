# ==============================================================================
# VOICEGUARD AI / VERIVOX AI — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# For Vercel deployment, configure these keys under Project Settings > Environment Variables.

# ------------------------------------------------------------------------------
# 1. Google Gemini API Key (REQUIRED for Text Scam Analysis & AI Safety Copilot)
# ------------------------------------------------------------------------------
# Generate your free API key at Google AI Studio: https://aistudio.google.com/
# Strictly server-side: Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Python Multimodal Deepfake Microservice URL (OPTIONAL)
# ------------------------------------------------------------------------------
# Local development default: http://127.0.0.1:8000
# Production deployment: URL of your deployed Python container (e.g. on Hugging Face Spaces, Render, or Railway)
# Example: https://voiceguard-detector.hf.space or https://voiceguard-backend.onrender.com
# If not configured, text analysis and offline safety knowledge base remain 100% functional,
# and audio/video tabs will guide the user to connect the inference service.
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 3. Application Metadata Configuration (OPTIONAL)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="VoiceGuard AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
